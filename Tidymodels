install.packages("lubridate")
install.packages("nycflights13")
install.packages("skimr")
install.packages("timeDate")
install.packages("rsample")

library("recipes")
library("kableExtra")
library("lubridate")
library("nycflights13")
library("skimr")
library("timeDate")
library("rsample")

set.seed(123)
flight_data <- 
  flights |> 
  mutate(
    arr_delay = ifelse(arr_delay >= 30, "late", "on_time"), #convert arrival delay to a factor
    arr_delay = factor(arr_delay),
    date = lubridate::as_date(time_hour)
  ) |> 
  inner_join(weather, by = c("origin", "time_hour")) |> #include the weather data
  select(dep_time, flight, origin, dest, air_time, distance, carrier, date, arr_delay, time_hour) |> 
  na.omit() |> #exclude missing data
  mutate_if(is.character, as.factor)  #for creating models, its better to have qualitive columns encoded AS FACTORS!!! (instead of character)

flight_data |> 
  count(arr_delay) |> 
  mutate(prop= n/sum(n))

glimpse(flight_data)
flight_data |> 
  skimr::skim(dest, carrier)

set.seed(222)
data_split <- initial_split(flight_data, prop = 3/4)   #put 3/4 of the data into the training set
train_data <- training(data_split)
test_data <- testing(data_split)

flights_rec <- 
  recipe(arr_delay ~ ., data= train_data)
